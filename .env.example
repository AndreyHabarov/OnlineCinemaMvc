# Скопируйте в .env и задайте локальный пароль перед запуском PostgreSQL.
POSTGRES_USER=cinema
POSTGRES_DB=cinemadb
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5434
APP_PORT=8080
# demo: автоматические фильмы/сеансы. production: без демоданных и аккаунтов.
CINEMA_MODE=demo
# Необязательно: создаётся только новый демоаккаунт, существующие не повышаются.
DEMO_ADMIN_ENABLED=false
DEMO_ADMIN_EMAIL=admin@example.invalid
DEMO_ADMIN_PASSWORD=
