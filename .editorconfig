root = true


[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{cs,cshtml,json,css,js}]
indent_style = space
indent_size = 4

[*.{json,yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[OnlineCinema.Mvc/wwwroot/lib/**]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset

# Встроенный Windows PowerShell 5.1 читает русские строки UTF-8 с BOM.
[scripts/{Start-Demo,Backup-Docker}.ps1]
charset = utf-8-bom
