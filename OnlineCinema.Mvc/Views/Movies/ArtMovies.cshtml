@model IEnumerable<ArtViewModel>
<h1 class="page-heading">Арт и авторское кино</h1>
@if (!Model.Any())
{
    @await Html.PartialAsync("_EmptyState", "Фильмов в разделе «Арт» пока нет.")
}
<div class="movie-grid">
    @foreach (var movie in Model)
    {
        <article class="movie-card">
            <a asp-controller="Movies" asp-action="Get" asp-route-id="@movie.Id"><img src="~/@movie.CardImagePath.TrimStart('/')" class="movie-poster" alt="Постер фильма «@movie.Name»" loading="lazy"></a>
            <div class="movie-card-body">
                <h3 class="movie-card-title"><a asp-controller="Movies" asp-action="Get" asp-route-id="@movie.Id">@movie.Name</a></h3>
                <p class="movie-card-meta">@movie.AgeRating+</p>
                <a class="movie-card-action" asp-controller="Movies" asp-action="Get" asp-route-id="@movie.Id" asp-fragment="movie-sessions">Сеансы и билеты →</a>
            </div>
        </article>
    }
</div>
