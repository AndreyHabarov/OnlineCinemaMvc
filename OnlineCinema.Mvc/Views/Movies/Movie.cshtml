@using System.Globalization
@using OnlineCinema.Mvc.Services
@model MovieViewModel

@functions {
    string GetDay(DateTime sessionDate)
    {
        if (Model.IsDemoCalendar) return sessionDate.ToString("dddd", CultureInfo.GetCultureInfo("ru-RU"));
        var dateNow = CinemaTime.Now;
        var currentDate = new DateTime(dateNow.Year, dateNow.Month, dateNow.Day);
        var differenceDate = sessionDate - currentDate;
        if (sessionDate.Date == dateNow.Date)
        {
            return "сегодня";
        }
        else if (differenceDate.TotalDays == 1)
        {
            return "завтра";
        }
        else
        {
            return sessionDate.ToString("dddd", CultureInfo.GetCultureInfo("ru-RU"));
        }
    }
}

<section class="movie-hero">
    <img src="~/@Model.PosterPath.TrimStart('/')" alt="Постер фильма «@Model.Name»" class="movie-hero-poster">
    <div>
        <input id="movie-id" type="hidden" value="@Model.Id">
        <p class="eyebrow">На большом экране</p>
        <h1>@Model.Name</h1>
        <p class="text-secondary">@Model.WorldPremiere.Year · @Model.Country · @Model.AgeRating+ · @Model.Duration мин</p>
        <div class="genre-list">@foreach (var genre in Model.Genres) { <span class="genre-tag">@genre</span> }</div>
        <div class="action-row">
            @if (Model.SessionDates.Length > 0) { <a href="#movie-sessions" class="btn btn-primary">Купить билет</a> }
            <a href="#movie-description" class="btn btn-outline-light">О фильме</a>
        </div>
        @if (Model.SessionDates.Length == 0) { <p class="mt-3 text-secondary">Предстоящих сеансов пока нет. Покупка станет доступна после появления расписания.</p> }
    </div>
</section>
<section class="surface movie-sessions" id="movie-sessions" aria-labelledby="sessions-heading">
    <h2 id="sessions-heading">Сеансы и покупка билетов</h2>
    @if (Model.IsDemoCalendar)
    {
        <p class="demo-notice">Демонстрационный календарь: @Model.DemoCalendarLabel. Эти даты доступны независимо от сегодняшнего дня; билет предназначен для проверки приложения.</p>
    }
    <p class="text-secondary">Выберите дату и сеанс, затем нажмите «Купить билет», чтобы выбрать места. Покупка демонстрационная, деньги не списываются.</p>
    <div class="session-filters" aria-label="Дата сеанса">
        @for (var dateIndex = 0; dateIndex < Model.SessionDates.Length; dateIndex++)
        {
            var sessionDate = Model.SessionDates[dateIndex];
            <button type="button" class="btn session-date @(dateIndex == 0 ? "active" : "")" data-date="@sessionDate.ToString("dd.MM.yyyy")" aria-pressed="@(dateIndex == 0 ? "true" : "false")">
                @sessionDate.ToString(Model.IsDemoCalendar ? "d MMMM yyyy" : "d MMMM", CultureInfo.GetCultureInfo("ru-RU"))<div>@GetDay(sessionDate)</div>
            </button>
        }
    </div>
    <div class="session-filters" aria-label="Зал">
        <button class="btn session-hall active" id="btn-all-halls" type="button" aria-pressed="true">Все залы</button>
        @foreach (var hall in Model.Halls)
        {
            <button class="btn session-hall" data-hall-id="@hall.Id" type="button" aria-pressed="false">@hall.Name</button>
        }
    </div>
    <p class="text-secondary">Время сеансов — московское (UTC+3).</p>
    <div id="sessions-container" class="session-list" aria-live="polite" aria-busy="false"><p>Загрузка сеансов…</p></div>
</section>
<section id="movie-description" class="movie-description surface">
    <h2>О фильме</h2>
    <p>@Model.Description</p>
    <dl class="row mb-0">
        <dt class="col-sm-3">Год выпуска</dt><dd class="col-sm-9">@Model.WorldPremiere.Year</dd>
        <dt class="col-sm-3">Страна</dt><dd class="col-sm-9">@Model.Country</dd>
        <dt class="col-sm-3">Режиссёр</dt><dd class="col-sm-9">@Model.Director</dd>
        <dt class="col-sm-3">В ролях</dt><dd class="col-sm-9">@Model.Actor</dd>
    </dl>
</section>
@section Scripts { <script src="~/js/views/movie/movie.js" asp-append-version="true"></script> }

@if (Model.CastPhotos.Count > 0)
{
    <section class="movie-cast" aria-labelledby="cast-heading">
        <h2 id="cast-heading" class="section-heading">@(Model.IsVoiceCast ? "Голоса персонажей" : "Актёры фильма")</h2>
        @if (Model.IsVoiceCast) { <p class="text-secondary">Исполнители в оригинальной версии мультфильма.</p> }
        <div class="cast-grid">
            @foreach (var actor in Model.CastPhotos)
            {
                <article class="cast-card">
                    <img src="~/@actor.PhotoPath" alt="@actor.Name" loading="lazy">
                    <h3>@actor.Name</h3>
                </article>
            }
        </div>
        <details class="cast-credits">
            <summary>Источники и лицензии фотографий</summary>
            <ul>
                @foreach (var actor in Model.CastPhotos)
                {
                    var licenseName = actor.License == "Public domain" ? "Общественное достояние" : actor.License;
                    <li>@actor.Name — @actor.Photographer. <a href="@actor.SourcePage" target="_blank" rel="noopener noreferrer">Источник</a>, <a href="@actor.LicenseUrl" target="_blank" rel="noopener noreferrer">@licenseName</a>.</li>
                }
            </ul>
            <p>Фотографии разных лет; использованы с кадрированием для карточек.</p>
        </details>
    </section>
}
