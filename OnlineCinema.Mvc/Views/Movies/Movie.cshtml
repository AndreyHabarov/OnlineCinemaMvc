@using System.Globalization
@using OnlineCinema.Mvc.Services
@model MovieViewModel

@functions {
    string GetDay(DateTime sessionDate)
    {
        var dateNow = CinemaTime.Now;
        var currentDate = new DateTime(dateNow.Year, dateNow.Month, dateNow.Day);
        var differenceDate = sessionDate - currentDate;
        if (sessionDate.Date == dateNow.Date)
        {
            return "сегодня";
        }
        else if (differenceDate.TotalDays == 1)
        {
            return "завтра";
        }
        else
        {
            return sessionDate.ToString("dddd", CultureInfo.GetCultureInfo("ru-RU"));
        }
    }
}


<div class="container-fluid mt-4">
    <div class="row align-items-center">
        <div class="col-md align-self-start text-white">
            <input id="MovieId" hidden class="d-none" value="@Model.Id" />
            <h1>@Model.Name</h1>
            <p class="text-white-50">@Model.WorldPremiere.Year · @Model.Country · @Model.AgeRating+</p>
            @if (Model.SessionDates.Length > 0)
            {
                <a href="#movie-sessions" class="btn btn-primary mb-3">Купить билет</a>
            }
            else
            {
                <p>Предстоящих сеансов пока нет. Покупка станет доступна после появления расписания.</p>
            }
            <div class="row">
                <div class="col-2">
                    @foreach (var genre in Model.Genres)
                    {
                        <p>@genre</p>
                    }
                </div>
                <div class="col">
                    <p>@Model.Duration мин</p>
                </div>
            </div>
            <div class="row">
                <a href="#movie-description">ПОДРОБНЕЕ О ФИЛЬМЕ</a>
            </div>
        </div>
    </div>
</div>

<div class="w-100 bg-secondary full-width-line mt-3 mb-3" style="height: 1px;"></div>

<section class="container-fluid text-white" id="movie-sessions" aria-labelledby="sessions-heading">
    <h2 id="sessions-heading" class="h4">Сеансы и покупка билетов</h2>
    <p>Выберите дату и сеанс, затем нажмите «Купить билет», чтобы выбрать места.
        Покупка демонстрационная, деньги не списываются.</p>

    <div class="d-flex align-items-center flex-wrap" aria-label="Дата сеанса">
        @for (var dateIndex = 0; dateIndex < Model.SessionDates.Length; dateIndex++)
        {
            var sessionDate = Model.SessionDates[dateIndex];
            <button type="button" class="btn btn-outline movie__session__btn @(dateIndex == 0 ? "active" : "")" data-date="@sessionDate.ToString("dd.MM.yyyy")">
                @sessionDate.ToString("d MMMM", CultureInfo.GetCultureInfo("ru-RU"))
                <div>@GetDay(sessionDate)</div>
            </button>
        }
    </div>
    <div class="d-flex align-items-center flex-wrap" aria-label="Зал">
        <button class="btn btn-outline all__hall__btn active" id="btnAllHalls">
            Все
        </button>
        @foreach (var hall in Model.Halls)
        {
            <button class="btn btn-outline hall__other__btn" data-hall-id="@hall.Id">
                @hall.Name
            </button>
        }
    </div>
</section>

<div class="container mt-3">
    <div class="row">
        <div class="col-md-2">
            <img src="~/@Model.PosterPath.TrimStart('/')" alt="Постер фильма «@Model.Name»" class="img-fluid rounded custom-img">
        </div>
        <div class="col-md-2 text-white">
            <p>@Model.AgeRating+</p>
            <p>@Model.Name</p>
            <p>@Model.Duration мин</p>
        </div>
        <div class="col-md-8 text-white">
            <p class="text-white-50">Время сеансов — московское (UTC+3).</p>
            <div id="sessions-container" class="row" aria-live="polite" aria-busy="false">
                <p>Загрузка сеансов…</p>
            </div>
        </div>
        <section id="movie-description" class="text-white mt-4">
            <h2 class="h4">О фильме</h2>
            <p>@Model.Description</p>
            <dl class="row">
                <dt class="col-sm-3">Год выпуска</dt>
                <dd class="col-sm-9">@Model.WorldPremiere.Year</dd>
                <dt class="col-sm-3">Страна</dt>
                <dd class="col-sm-9">@Model.Country</dd>
                <dt class="col-sm-3">Режиссёр</dt>
                <dd class="col-sm-9">@Model.Director</dd>
                <dt class="col-sm-3">В ролях</dt>
                <dd class="col-sm-9">@Model.Actor</dd>
            </dl>
        </section>
    </div>
</div>


@section Scripts {
    <script src="~/js/views/movie/Movie.js" asp-append-version="true"></script>
}
