@model IEnumerable<PromotionViewModel>

@{
    if (!Model.Any())
    {
        @await Html.PartialAsync("_EmptyState", "Акций пока нет.")
    }
    int count = 1;
    foreach (var promotion in Model)
    {
        var link = PublicUrls.NavigationLink(promotion.Link);
        <div class="row">
            <div class="col promotion-item @(count % 2 == 0 ? "reverse": "normal")">
                @if (link is null)
                {
                    <a asp-controller="Promotions" asp-action="Get" asp-route-name="@promotion.Name">
                        <img src="@promotion.ImagePath" class="img-fluid rounded-3" alt="Акция «@promotion.DisplayName»" />
                    </a>
                }
                else
                {
                    <a href="@link">
                        <img src="@promotion.ImagePath" class="img-fluid rounded-3" alt="Акция «@promotion.DisplayName»" />
                    </a>
                }
                <div>
                    <h3>
                        @promotion.DisplayName
                    </h3>
                    <p>@promotion.Description</p>
                    @if (link is null)
                    {
                        <a class="btn btn-primary learn__more__btn" asp-controller="Promotions" asp-action="Get" asp-route-name="@promotion.Name">@promotion.ButtonText</a>
                    }
                    else
                    {
                        <a href="@link" class="btn btn-primary learn__more__btn">@promotion.ButtonText</a>
                    }
                </div>
            </div>
        </div>
        count++;
    }
}
