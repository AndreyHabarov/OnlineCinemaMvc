@model IEnumerable<HomePosterViewModel>
@if (!Model.Any())
{
    @await Html.PartialAsync("_EmptyState", "Фильмов в каталоге пока нет.")
}
<div class="movie-grid">
    @foreach (var poster in Model)
    {
        <article class="movie-card">
            <a asp-controller="Movies" asp-action="Get" asp-route-id="@poster.Id"><img src="~/@poster.CardImagePath.TrimStart('/')" class="movie-poster" alt="Постер фильма «@poster.Name»" loading="lazy"></a>
            <div class="movie-card-body">
                <h3 class="movie-card-title"><a asp-controller="Movies" asp-action="Get" asp-route-id="@poster.Id">@poster.Name</a></h3>
                <p class="movie-card-meta">@poster.WorldPremiere.Year · @poster.AgeRating+</p>
                <a class="movie-card-action" asp-controller="Movies" asp-action="Get" asp-route-id="@poster.Id" asp-fragment="movie-sessions">Сеансы и билеты →</a>
            </div>
        </article>
    }
</div>
