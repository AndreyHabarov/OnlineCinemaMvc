@model IEnumerable<HomeNewsViewModel>
@if (!Model.Any())
{
    @await Html.PartialAsync("_EmptyState", "Новостей пока нет.")
}
<div class="news-grid">
    @foreach (var news in Model)
    {
        <article class="card news-card">
            <a asp-controller="News" asp-action="GetNewsById" asp-route-id="@news.Id"><img src="@news.ImagePath" class="card-img-top" alt="Новость «@news.Name»" loading="lazy"></a>
            <div class="card-body">
                <h3 class="h5"><a asp-controller="News" asp-action="GetNewsById" asp-route-id="@news.Id">@news.Name</a></h3>
                <p class="text-secondary mb-0"><small>@news.Date.ToString("f")</small></p>
            </div>
        </article>
    }
</div>
