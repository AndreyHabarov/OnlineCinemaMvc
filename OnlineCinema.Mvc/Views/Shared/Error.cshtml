@using OnlineCinemaMvc.Models
@model ErrorViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="ru">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ошибка — Кинотеатр MovieMax</title>
    <link rel="stylesheet" href="~/css/error.css" asp-append-version="true" />
</head>
<body>
    <main>
        <p class="brand">Кинотеатр MovieMax</p>
        <h1>Не удалось открыть страницу</h1>
        <p>Во время обработки запроса произошла ошибка. Попробуйте снова немного позже.</p>
        <p>Если вы покупали билет, проверьте личный кабинет перед повторной покупкой.</p>
        <nav aria-label="Действия после ошибки">
            <a href="@Url.Content("~/")">На главную</a>
            <a href="@Url.Content("~/lk")">Личный кабинет</a>
        </nav>
        @if (Model.ShowRequestId)
        {
            <p class="request-id">Код обращения: <code>@Model.RequestId</code></p>
        }
    </main>
</body>
</html>
