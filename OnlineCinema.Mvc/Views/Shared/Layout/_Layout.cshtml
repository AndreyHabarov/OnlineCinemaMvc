<!DOCTYPE html>
<html lang="ru" data-bs-theme="dark">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]Кинотеатр MovieMax</title>
    <link rel="icon" type="image/png" href="~/images/logo/logo.png"/>
    @await Html.PartialAsync("_Styles.cshtml")
</head>
<body>
    <a class="skip-link" href="#main-content">Перейти к содержимому</a>
    @await Html.PartialAsync("_Header.cshtml")
    @RenderSection("Banner", false)
    <div class="container site-content">
        <main role="main" class="pb-3" id="main-content" tabindex="-1">
            @RenderBody()
        </main>
    </div>
    @await Html.PartialAsync("_PersonalAccountModal.cshtml")
    @await Html.PartialAsync("_Footer.cshtml")

    @await Html.PartialAsync("_Scripts.cshtml")
    @RenderSection("Scripts", false)
</body>
</html>
