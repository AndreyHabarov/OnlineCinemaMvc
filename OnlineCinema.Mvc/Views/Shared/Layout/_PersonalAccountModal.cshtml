<div class="modal" tabindex="-1" id="PersonalAccountModal">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content">

            <div class="modal-header">
                <div class="d-flex justify-content-start personal__account__navbuttons">
                    <ul class="nav nav-underline" role="tablist">
                        <li class="nav-item me-1">
                            <a class="nav-link active" id="LoginTab" data-bs-toggle="tab" href="#Login" role="tab">ВХОД</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" id="RegistrationTab" data-bs-toggle="tab" href="#Registration" role="tab">РЕГИСТРАЦИЯ</a>
                        </li>
                    </ul>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>

            <div class="tab-content" id="myTabContent">
                <!-- Вход -->
                <div class="tab-pane fade show active" id="Login" role="tabpanel">
                    <div class="container-fluid">
                        <div class="row d-flex justify-content-between align-items-center">

                            <div class="container-fluid mb-2">
                                <div class="row d-flex justify-content-between align-items-center">
                                    <div class="col">
                                        <p class="mt-2 fw-bolder">Способ авторизации</p>

                                        <ul class="nav nav-pills mb-2 contact__btns__custom" id="pills-tab" role="tablist">
                                            <li class="nav-item" role="presentation">
                                                <button class="nav-link active " id="EmailBtn" data-bs-toggle="pill" data-bs-target="#pills-email" type="button" role="tab">Email</button>
                                            </li>
                                            <li class="nav-item" role="presentation">
                                                <button class="nav-link" id="PhoneBtn" data-bs-toggle="pill" data-bs-target="#pills-phone" type="button" role="tab">Телефон</button>
                                        </ul>
                                    </div>
                                    <div class="col">
                                        <p>
                                            Нажимая кнопку входа, вы принимаете условия <a class="personal__agreement__text" href="#">Пользовательского соглашения</a>
                                        </p>
                                    </div>
                                </div>
                            </div>

                            <div class="col-6 personal__login__input">
                                <div class="input-group mb-3" id="EmailWrapper">
                                    <span class="input-group-text"><i class="fa-solid fa-at"></i></span>
                                    <input id="Email" type="text" class="form-control" placeholder="Ваш email">
                                </div>
                                <div class="input-group mb-3 d-none" id="PhoneWrapper">
                                    <span class="input-group-text"><i class="fa-solid fa-mobile-screen-button"></i></span>
                                    <input id="Phone" type="text" class="form-control" placeholder="Ваш номер телефона">
                                </div>
                                <div class="input-group mb-3">
                                    <span class="input-group-text"><i class="fa-solid fa-unlock-keyhole"></i></span>
                                    <input id="Password" type="password" autocomplete="current-password" class="form-control" placeholder="Пароль">
                                </div>
                                <div class="d-flex justify-content-between align-items-center">
                                    <div class=" form-check remember__me__btn">
                                        <input class="form-check-input" type="checkbox" id="FlexCheckIndeterminate">
                                        <label class="form-check-label ms-2" for="FlexCheckIndeterminate">Запомнить меня</label>
                                    </div>
                                    <a class="forget__password__text" href="#">Забыли пароль?</a>
                                </div>
                                <p id="LoginError" class="text-danger" role="alert"></p>
                                <button type="button" class="btn btn-primary enter__btn__custom w-100 mt-3 mb-3 " id="LoginButton">Войти</button>
                            </div>


                        </div>
                    </div>
                </div>

                <!-- Регистрация -->
                <div class="tab-pane fade" id="Registration" role="tabpanel">
                    <div class="container mt-3">
                        <p>Укажите ваши данные</p>
                        <div class="row personal__registration__input">
                            <div class="col-6">
                                <div class="input-group mb-3">
                                    <span class="input-group-text"><i class="fa-solid fa-mobile-screen-button"></i></span>
                                    <input type="text" class="mask-phone form-control" placeholder="Ваш номер телефона" id="PhoneRegistration">
                                </div>
                                <div class="input-group mb-3">
                                    <span class="input-group-text"><i class="fa-regular fa-circle-user"></i></span>
                                    <input type="text" class="form-control" placeholder="Ваше имя" id="NameRegistration">
                                </div>
                                <div class="input-group mb-3 has-validation">
                                    <span class="input-group-text" id="inputGroupPrepend3"><i class="fa-solid fa-lock"></i></span>
                                    <input type="password" class="form-control" id="EnterPassword" required placeholder="Придумайте пароль">
                                    <div id="EnterPasswordValidation" class="invalid-feedback">
                                    </div>
                                </div>
                                <p style="font-size: 12px;">Пароль должен содержать цифры, заглавные и строчные буквы. Длина — от 8 до 128 символов.</p>
                            </div>

                            <div class="col-6">
                                <div class="input-group mb-3">
                                    <span class="input-group-text"><i class="fa-solid fa-at"></i></span>
                                    <input type="email" class="form-control" placeholder="Введите ваш email" id="EmailRegistration">
                                </div>
                                <div class="input-group mb-3">
                                    <span class="input-group-text"><i class="fa-regular fa-circle-user"></i></span>
                                    <input type="text" class="form-control" placeholder="Ваша фамилия" id="SurnameRegistration">
                                </div>
                                <div class="input-group mb-3 has-validation">
                                    <span class="input-group-text" id="inputGroupPrepend3"><i class="fa-solid fa-lock"></i></span>
                                    <input type="password" class="form-control" id="RepeatPassword" required placeholder="Повторите пароль">
                                    <div id="ConfirmPasswordValidation" class="invalid-feedback">
                                    </div>
                                </div>
                                <div class="input-group mb-3">
                                    <span class="input-group-text"><i class="fa-solid fa-venus-mars"></i></span>
                                    <select id="GenderRegistration" class="form-select">
                                        <option disabled selected>Укажите ваш пол</option>
                                        <option value="male">Мужской</option>
                                        <option value="female">Женский</option>
                                    </select>
                                </div>
                            </div>
                        </div>
                        <p id="RegistrationError" class="text-danger" role="alert"></p>
                        <div class="d-flex justify-content-center">
                            <button type="button" class="btn btn-primary registration__btn_custom w-50 mb-3 mt-3" id="RegistrationButton">Зарегистрироваться</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
