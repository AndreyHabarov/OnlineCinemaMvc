@model IReadOnlyList<OnlineCinema.Mvc.Models.ViewModels.Home.CatalogGenreViewModel>
@if (Model.Count > 0)
{
    <nav class="footer-column" aria-label="Жанры фильмов">
        <h2 class="footer-heading">По настроению</h2>
        @foreach (var genre in Model)
        {
            <a asp-area="" asp-controller="Home" asp-action="Index" asp-route-genreId="@genre.Id" asp-fragment="movie-catalog">@genre.Name</a>
        }
        <a href="/#movie-catalog">Все жанры →</a>
    </nav>
}
