@model NewsViewModel
<article class="detail-page">
    <p class="eyebrow">Новости кинотеатра</p>
    <h1 class="page-heading">@Model.Name</h1>
    <p class="text-secondary">@Model.Date.ToString("f")</p>
    <img src="~/@Model.ImagePath.TrimStart('/')" class="detail-image" alt="Новость «@Model.Name»">
    <p class="detail-description">@Model.Description</p>
    <a asp-controller="News" asp-action="GetAll">← Все новости</a>
</article>
