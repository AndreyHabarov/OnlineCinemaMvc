<section id="admin-catalog" data-kind="promotions" class="admin-catalog">
    <div class="admin-heading">
        <h1>Акции</h1><button id="catalog-add" class="btn btn-outline-light">Добавить акцию</button>
    </div>
    <p id="catalog-error" class="text-danger" role="alert"></p>
    <div class="admin-table-scroll"><table id="catalog-table" class="table"><thead><tr><th>Название</th><th>Дата</th><th>Действия</th></tr></thead></table></div>
</section>
<div class="modal fade" id="catalog-modal" tabindex="-1" aria-labelledby="catalog-title">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <div class="modal-header"><h2 id="catalog-title" class="h5">Акция</h2><button class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button></div>
        <form id="catalog-form"><div class="modal-body">
            <input type="hidden" name="Id" value="0">
            <label class="form-label" for="promotion-name">Адрес акции (латинские буквы, цифры, дефисы)</label><input id="promotion-name" name="Name" class="form-control mb-2" required maxlength="100">
            <label class="form-label" for="promotion-display-name">Название</label><input id="promotion-display-name" name="DisplayName" class="form-control mb-2" required maxlength="150">
            <label class="form-label" for="promotion-description">Описание</label><textarea id="promotion-description" name="Description" class="form-control mb-2" required maxlength="5000"></textarea>
            <label class="form-label" for="promotion-date">Дата</label><input id="promotion-date" name="DateTime" type="date" class="form-control mb-2" required>
            <label class="form-label" for="promotion-button">Текст кнопки</label><input id="promotion-button" name="ButtonText" class="form-control mb-2" required maxlength="100">
            <label class="form-label" for="promotion-link">Ссылка (необязательно)</label><input id="promotion-link" name="Link" class="form-control mb-2" maxlength="500">
            <label class="form-label" for="promotion-image">Изображение: JPEG, PNG или WebP, до 2 МБ</label><input id="promotion-image" name="Image" type="file" class="form-control mb-2" accept="image/jpeg,image/png,image/webp">
            <img id="catalog-preview" class="img-fluid" hidden alt="Изображение акции">
            <p id="catalog-form-error" class="text-danger" role="alert"></p>
        </div><div class="modal-footer"><button id="catalog-save" type="submit" class="btn btn-primary">Сохранить</button><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button></div></form>
    </div></div>
</div>
@section Scripts { <script src="~/js/admin-catalog.js" asp-append-version="true"></script> }
