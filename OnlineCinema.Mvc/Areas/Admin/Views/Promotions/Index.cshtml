<section id="AdminCatalog" data-kind="promotions" class="text-white">
    <div class="d-flex justify-content-between align-items-center">
        <h1>Акции</h1><button id="CatalogAdd" class="btn btn-outline-light">Добавить акцию</button>
    </div>
    <p id="CatalogError" class="text-danger" role="alert"></p>
    <table id="CatalogTable" class="table"><thead><tr><th>Название</th><th>Дата</th><th>Действия</th></tr></thead></table>
</section>
<div class="modal fade" id="CatalogModal" tabindex="-1" aria-labelledby="CatalogTitle">
    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
        <div class="modal-header"><h2 id="CatalogTitle" class="h5">Акция</h2><button class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button></div>
        <form id="CatalogForm"><div class="modal-body">
            <input type="hidden" name="Id" value="0">
            <label class="form-label" for="PromotionName">Адрес акции (латинские буквы, цифры, дефисы)</label><input id="PromotionName" name="Name" class="form-control mb-2" required maxlength="100">
            <label class="form-label" for="PromotionDisplayName">Название</label><input id="PromotionDisplayName" name="DisplayName" class="form-control mb-2" required maxlength="150">
            <label class="form-label" for="PromotionDescription">Описание</label><textarea id="PromotionDescription" name="Description" class="form-control mb-2" required maxlength="5000"></textarea>
            <label class="form-label" for="PromotionDate">Дата</label><input id="PromotionDate" name="DateTime" type="date" class="form-control mb-2" required>
            <label class="form-label" for="PromotionButton">Текст кнопки</label><input id="PromotionButton" name="ButtonText" class="form-control mb-2" required maxlength="100">
            <label class="form-label" for="PromotionLink">Ссылка (необязательно)</label><input id="PromotionLink" name="Link" class="form-control mb-2" maxlength="500">
            <label class="form-label" for="PromotionImage">Изображение: JPEG, PNG или WebP, до 2 МБ</label><input id="PromotionImage" name="Image" type="file" class="form-control mb-2" accept="image/jpeg,image/png,image/webp">
            <img id="CatalogPreview" class="img-fluid" hidden alt="Изображение акции">
            <p id="CatalogFormError" class="text-danger" role="alert"></p>
        </div><div class="modal-footer"><button id="CatalogSave" type="submit" class="btn btn-primary">Сохранить</button><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button></div></form>
    </div></div>
</div>
@section Scripts { <script src="~/js/admin-catalog.js" asp-append-version="true"></script> }
